#!/usr/bin/env bash
# Model-owned cluster settings. This file is the only SLURM file expected to need routine edits.
PARTITION_CPU="cpu"
PARTITION_GPU="gpu"
TIME_CPU="01:00:00"
TIME_GPU="04:00:00"
CPUS="4"
MEMORY="16G"
GPUS="1"
RUN_ROOT="${RUN_ROOT:-runs}"

# Print the implementation-specific key=value arguments for one command. Keep secrets out of this file;
# obtain them from the submit environment. Paths below are examples and must be finalized with tests/e2e.py.
stage_args() {
  case "$1" in
    preprocess_data) printf '%s\n' "external_meds_dir=${MEDS_ROOT:?set MEDS_ROOT}" "output_data_dir=${RUN_DIR:?set RUN_DIR}/data" ;;
    pretrain) printf '%s\n' "input_data_dir=$RUN_DIR/data" "output_pretrained_model_dir=$RUN_DIR/pretrained" ;;
{% if profile == 'zero_shot_materialized' %}    infer) printf '%s\n' "input_data_dir=$RUN_DIR/data" "input_pretrained_model_dir=$RUN_DIR/pretrained" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "output_inference_subdir=inference/default" ;;
{% else %}    infer) printf '%s\n' "input_data_dir=$RUN_DIR/data" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "output_inference_subdir=inference/default" ;;
{% endif %}    supervised_train) printf '%s\n' "input_data_dir=$RUN_DIR/data" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "output_supervised_model_dir=$RUN_DIR/model" ;;
{% if profile == 'zero_shot_materialized' %}    predict) printf '%s\n' "input_data_dir=$RUN_DIR/data" "external_meds_dir=${MEDS_ROOT:?set MEDS_ROOT}" "input_inference_subdir=inference/default" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "external_task_criteria_file=${TASK_CRITERIA_FILE:?set TASK_CRITERIA_FILE}" "output_predictions_dir=$RUN_DIR/predict" ;;
{% elif profile == 'zero_shot_direct' %}    predict) printf '%s\n' "input_data_dir=$RUN_DIR/data" "input_pretrained_model_dir=$RUN_DIR/pretrained" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "external_task_criteria_file=${TASK_CRITERIA_FILE:?set TASK_CRITERIA_FILE}" "output_predictions_dir=$RUN_DIR/predict" ;;
{% else %}    predict) printf '%s\n' "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "output_predictions_dir=$RUN_DIR/predict" ;;
{% endif %}    *) return 2 ;;
  esac
}
