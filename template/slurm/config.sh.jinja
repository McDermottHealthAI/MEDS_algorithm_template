#!/usr/bin/env bash
# Model-owned cluster settings. This file is the only SLURM file expected to need routine edits.
# Defaults; each can be overridden from the submit environment (e.g. MEMORY=96G STAGES=pretrain submit.sh), so a
# resource change does not need a commit. Size them per stage by submitting stages separately with STAGES.
PARTITION_CPU="${PARTITION_CPU:-cpu}"
PARTITION_GPU="${PARTITION_GPU:-gpu}"
TIME_CPU="${TIME_CPU:-01:00:00}"
TIME_GPU="${TIME_GPU:-04:00:00}"
CPUS="${CPUS:-4}"
MEMORY="${MEMORY:-16G}"
GPUS="${GPUS:-1}"
RUN_ROOT="${RUN_ROOT:-runs}"
{% if profiles | length == 1 %}PROFILE="${PROFILE:-{{ profiles[0] }}}"{% else %}: "${PROFILE:?select a declared profile}"{% endif %}
export PROFILE

# Shared artifacts may only be reused after validating their configuration and input identities.
# Embeddings need training/tuning keys to fit a probe. Inference never reads the label values.
# TASK_PREDICATES_FILE is separate from dataset-level PREDICATES_FILE.
stage_args() {
  case "$1" in
{% if 'supervised' in profiles or 'finetune' in profiles or 'probe' in profiles or 'zero_shot_direct' in profiles or 'zero_shot_materialized' in profiles or 'predict_only' in profiles %}    preprocess_data) printf '%s\n' "external_meds_dir=${MEDS_ROOT:?set MEDS_ROOT}" "output_data_dir=$SHARED_DIR/data"{% if uses_predicates %} "external_predicates_file=${PREDICATES_FILE:?set PREDICATES_FILE}"{% endif %} ;;
{% endif %}{% if 'supervised' in profiles %}    train_supervised) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "output_supervised_model_dir=$RUN_DIR/model" ;;
{% endif %}{% if 'supervised' in profiles %}    predict_supervised) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "input_supervised_model_dir=$RUN_DIR/model" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "output_predictions_dir=$RUN_DIR/predictions" "splits=[${SPLITS:-held_out}]" ;;
{% endif %}{% if 'finetune' in profiles or 'probe' in profiles or 'zero_shot_direct' in profiles or 'zero_shot_materialized' in profiles %}    pretrain) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "output_pretrained_model_dir=$SHARED_DIR/pretrained" ;;
{% endif %}{% if 'finetune' in profiles %}    train_finetune) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "input_pretrained_model_dir=$SHARED_DIR/pretrained" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "output_finetuned_model_dir=$RUN_DIR/model" ;;
{% endif %}{% if 'finetune' in profiles %}    predict_finetune) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "input_finetuned_model_dir=$RUN_DIR/model" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "output_predictions_dir=$RUN_DIR/predictions" "splits=[${SPLITS:-held_out}]" ;;
{% endif %}{% if 'probe' in profiles %}    infer_embeddings) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "input_pretrained_model_dir=$SHARED_DIR/pretrained" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "output_embeddings_dir=$RUN_DIR/embeddings" "splits=[${EMBEDDING_SPLITS:-train,tuning,held_out}]" ;;
{% endif %}{% if 'probe' in profiles %}    train_probe) printf '%s\n' "input_embeddings_dir=$RUN_DIR/embeddings" "external_labels_dir=${LABELS_DIR:?set LABELS_DIR}" "output_probe_model_dir=$RUN_DIR/model" ;;
{% endif %}{% if 'probe' in profiles %}    predict_probe) printf '%s\n' "input_embeddings_dir=$RUN_DIR/embeddings" "input_probe_model_dir=$RUN_DIR/model" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "output_predictions_dir=$RUN_DIR/predictions" "splits=[${SPLITS:-held_out}]" ;;
{% endif %}{% if 'zero_shot_direct' in profiles %}    predict_zero_shot_direct) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "input_pretrained_model_dir=$SHARED_DIR/pretrained" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "external_task_criteria_file=${TASK_CRITERIA_FILE:?set TASK_CRITERIA_FILE}" "output_predictions_dir=$RUN_DIR/predictions" "splits=[${SPLITS:-held_out}]"{% if uses_predicates %} "external_predicates_file=${TASK_PREDICATES_FILE:-${PREDICATES_FILE:?set PREDICATES_FILE}}"{% endif %} ;;
{% endif %}{% if 'zero_shot_materialized' in profiles %}    infer_trajectories) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "input_pretrained_model_dir=$SHARED_DIR/pretrained" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "output_trajectories_dir=$RUN_DIR/trajectories" "splits=[${SPLITS:-held_out}]" ;;
{% endif %}{% if 'zero_shot_materialized' in profiles %}    predict_zero_shot_materialized) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "external_meds_dir=${MEDS_ROOT:?set MEDS_ROOT}" "input_trajectories_dir=$RUN_DIR/trajectories" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "external_task_criteria_file=${TASK_CRITERIA_FILE:?set TASK_CRITERIA_FILE}" "output_predictions_dir=$RUN_DIR/predictions" "splits=[${SPLITS:-held_out}]"{% if uses_predicates %} "external_predicates_file=${TASK_PREDICATES_FILE:-${PREDICATES_FILE:?set PREDICATES_FILE}}"{% endif %} ;;
{% endif %}{% if 'predict_only' in profiles %}    predict_only) printf '%s\n' "input_data_dir=$SHARED_DIR/data" "external_index_dir=${INDEX_DIR:?set INDEX_DIR to the prediction index}" "output_predictions_dir=$RUN_DIR/predictions" "splits=[${SPLITS:-held_out}]" ;;
{% endif %}    *) return 2 ;;
  esac
}
