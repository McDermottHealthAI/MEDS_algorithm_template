import os
import subprocess
from pathlib import Path

import yaml
import pytest

from {{ algorithm_slug }}.{{ algorithm_slug }} import PROFILES

from meds_algorithm import ALGORITHM_PROFILES


ROOT = Path(__file__).parents[1]


@pytest.mark.parametrize("profile", PROFILES)
def test_algorithm_yaml_is_a_meds_dev_descriptor(profile):
    descriptor = yaml.safe_load((ROOT / "algorithms" / profile / "model.yaml").read_text())
    assert set(descriptor) == {"metadata", "commands"}
    assert "supervised" in descriptor["commands"]
    assert descriptor["commands"]["supervised"]["predict"]


@pytest.mark.parametrize("profile", PROFILES)
def test_slurm_dry_run_is_non_mutating(profile):
    before = {p.relative_to(ROOT) for p in ROOT.rglob("*")}
    result = subprocess.run(
        ["bash", "slurm/submit.sh", "--dry-run"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=True,
        # Example values: the dry run only prints arguments, so the paths need not exist.
        env={
            "MEDS_ROOT": "/example/meds",
            "LABELS_DIR": "/example/labels",
            "INDEX_DIR": "/example/index",
            "TASK_CRITERIA_FILE": "/example/task.yaml",
            "PREDICATES_FILE": "/example/predicates.yaml",
            **os.environ,
            "PYTHONDONTWRITEBYTECODE": "1",
            "PROFILE": profile,
        },
    )
    after = {p.relative_to(ROOT) for p in ROOT.rglob("*")}
    assert before == after
    for command in ALGORITHM_PROFILES[profile]:
        assert command.value in result.stdout
    assert "sbatch" in result.stdout
