"""Run this completed repository through MEDS-DEV's isolated algorithm environment."""

from pathlib import Path

import pytest

from meds_algorithm.integrations.meds_dev import register
from meds_algorithm.conformance.assertions import read_predictions
from {{ algorithm_slug }}.{{ algorithm_slug }} import STUB_PROFILES, PROFILES

from meds_algorithm.conformance.meds_dev import RUN_TIMEOUT, assert_prediction_keys, assert_prediction_schema, provision_meds_dev, run, venv_bin

pytestmark = [pytest.mark.slow, pytest.mark.meds_dev]
ROOT = Path(__file__).parents[1]
ALGORITHM_NAME = "{{ algorithm_slug }}"


@pytest.fixture(scope="session")
def meds_dev(request, tmp_path_factory):
    if set(PROFILES) <= STUB_PROFILES:
        pytest.skip("algorithm_stub: MEDS-DEV runs only after the real algorithm profile is implemented")
    return provision_meds_dev(request, tmp_path_factory{% if 'zero_shot_direct' in profiles or 'zero_shot_materialized' in profiles %}, task_criteria=True{% endif %})


@pytest.mark.parametrize("profile", PROFILES)
def test_meds_dev_runs_algorithm_yaml(meds_dev, tmp_path, profile):
    if profile in STUB_PROFILES:
        pytest.skip("algorithm_stub: implement this profile")
    import yaml

    from .e2e import prepare_meds_dev_run

    registered = register(ROOT, meds_dev, ALGORITHM_NAME, profile)
    assert (registered / "model.yaml").is_file()
    prepared = prepare_meds_dev_run(meds_dev, tmp_path, profile=profile)
    run([venv_bin(meds_dev) / "meds-dev-model", f"model={registered.name}", *prepared.args], timeout=RUN_TIMEOUT)

    predictions = read_predictions(prepared.predictions_dir)
    assert_prediction_schema(predictions)
    assert predictions.height > 0
    assert predictions.select("subject_id", "prediction_time").unique().height == predictions.height
    manifest = yaml.safe_load((prepared.predictions_dir / "manifest.yaml").read_text())
    assert manifest["artifact"]["type"] == "predictions"
    assert_prediction_keys(prepared.predictions_dir, prepared.labels_dir, prepared.splits)
    assert manifest["resources"]["memory"]["peak_process_tree_rss_bytes"] > 0
