from meds_model_core import MODEL_PROFILES
from {{ model_slug }}.commands import PROFILES, create_repository
from {{ model_slug }}.config import Config


def test_profile_implementations_match_contract():
    repository = create_repository()
    for profile in PROFILES:
        assert repository.profile_commands(profile) == MODEL_PROFILES[profile]


def test_model_configuration_roundtrips(tmp_path):
    config = Config()
    path = config.save(tmp_path / "config.json")
    assert Config.load(path) == config
