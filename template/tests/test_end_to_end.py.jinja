def _task_artifacts(result):
    return {command.value: result.artifacts[command.value] for command in ZERO_SHOT_TASK_COMMANDS["{{ profile }}"]}


def test_zero_shot_artifacts_name_their_task_and_relaxations(tmp_path: Path):
    if IS_STUB:
        pytest.skip("model_stub: implement commands and the repository-specific run_e2e adapter")
    from .e2e import run_e2e

    result = run_e2e(tmp_path)
    task = TaskSpec.from_arguments(result.inputs)
    for command, directory in _task_artifacts(result).items():
        manifest = read_manifest(directory)
        assert manifest["semantics_digest"] == task.semantics_digest(), f"{command} is not bound to the task"
        assert manifest["inputs"]["task"]["criteria_file"]["digest"].startswith("sha256:")
    ledgers = [path.parent for d in result.artifacts.values() for path in Path(d).rglob("relaxations.yaml")]
    assert ledgers, "encode must publish relaxations.yaml with the inference target"
    for directory in ledgers:
        RelaxationLedger.read(directory)  # raises unless query_language, decoded_quantity, and exact are set

