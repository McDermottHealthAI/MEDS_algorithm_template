"""End-to-end contract test for this rendered repository's real implementation.

Replace ``run_e2e`` and ``fitted_codes`` in `tests/e2e.py` with fixture preparation, command arguments, and
artifact reading appropriate to the model. A completed port must have no `model_stub` skip.

One run of the real profile backs every check below, so the most expensive step happens once.
"""

from pathlib import Path

import pytest

from meds_model_contract import MODEL_PROFILES, STEP_SPECS, CommandName, {% if 'zero_shot_direct' in profiles or 'zero_shot_materialized' in profiles %}ZERO_SHOT_TASK_COMMANDS, RelaxationLedger, TaskSpec, {% endif %}read_manifest
from {{ model_slug }}.commands import STUB_PROFILES, PROFILES


def _strip_labels(labels_dir: Path, destination: Path, splits) -> Path:
    """Copy the index, keeping only the keys of the given splits' files (every file when ``splits`` is None)."""
    import polars as pl

    from meds_model_contract import split_files

    stripped = set(split_files(labels_dir, splits)) if splits else None
    for path in sorted(Path(labels_dir).rglob("*.parquet")):
        target = destination / path.relative_to(labels_dir)
        target.parent.mkdir(parents=True, exist_ok=True)
        if stripped is None or path in stripped:
            pl.read_parquet(path, columns=["subject_id", "prediction_time"]).write_parquet(target)
        else:
            pl.read_parquet(path).write_parquet(target)
    return destination


@pytest.mark.parametrize("profile", PROFILES)
def test_end_to_end(tmp_path: Path, profile):
    if profile in STUB_PROFILES:
        pytest.skip("model_stub: implement commands and the repository-specific run_e2e adapter")
    from {{ model_slug }}.__main__ import REPOSITORY

    from .e2e import fitted_codes, run_e2e
    from .integration import assert_prediction_keys, assert_prediction_schema

    result = run_e2e(tmp_path / "run", profile=profile)
    artifacts = result.artifacts
    assert list(artifacts) == [command.value for command in MODEL_PROFILES[profile]]
    for command, directory in artifacts.items():
        manifest = read_manifest(directory)
        assert manifest["command"]["name"] == command
        assert manifest["artifact"]["type"] == STEP_SPECS[CommandName(command)].artifact_type.value
        assert str(manifest["command"]["config_digest"]).startswith("sha256:"), f"{command} has no config digest"
        resources = manifest["resources"]
        assert resources["wall_seconds"] >= 0
        assert resources["memory"]["peak_process_tree_rss_bytes"] > 0
    prediction_step = MODEL_PROFILES[profile][-1].value
    import polars as pl

    assert_prediction_schema(pl.read_parquet(artifacts[prediction_step] / "predictions.parquet"))
    prediction_manifest = read_manifest(artifacts[prediction_step])
    assert prediction_manifest["artifact"]["type"] == "predictions"
    assert_prediction_keys(artifacts[prediction_step], result.labels_dir, result.splits)

    # Absence of label leakage (SPEC 2.2): predict runs on an index whose evaluated splits have no label
    # column{% if 'zero_shot_direct' in profiles or 'zero_shot_materialized' in profiles %} (here: every split, since a zero-shot model reads no label at all){% endif %}, so any code path that
    # reads them fails here. This needs only one extra predict, and no determinism.
    assert result.predict_arguments, "run_e2e must return the predict_arguments it used"
    unlabelled = _strip_labels(
        result.labels_dir,
        tmp_path / "unlabelled-index",
        None if profile.startswith("zero_shot_") else result.splits,
    )
    blind = tmp_path / "unlabelled-predictions"
    REPOSITORY.run(
        prediction_step,
        {**result.predict_arguments, "external_index_dir": str(unlabelled), "external_evaluation_labels_dir": str(unlabelled), "output_predictions_dir": str(blind)},
        profile=profile,
    )
    assert_prediction_keys(blind, result.labels_dir, result.splits)

    # Absence of transductive fitting (SPEC 2.1): codes that occur only in tuning or held-out subjects must
    # not be part of anything the model fitted.
    assert set(result.canaries) == {"tuning", "held_out"}, (
        "run_e2e must apply tests.signal.add_split_canaries to its fixture and return the canaries"
    )
    leaked = set(result.canaries.values()) & set(fitted_codes(artifacts))
    assert not leaked, f"statistics were fitted over non-training splits: {sorted(leaked)}"
{% if 'zero_shot_direct' in profiles or 'zero_shot_materialized' in profiles %}
    # Zero-shot: every task-conditioned artifact names its task, and a ledger is published (SPEC 2.4, 3.1).
    if not profile.startswith("zero_shot_"):
        return
    task = TaskSpec.from_arguments(result.inputs)
    for command in ZERO_SHOT_TASK_COMMANDS.get(profile, ()):
        manifest = read_manifest(artifacts[command.value])
        assert manifest["semantics_digest"] == task.semantics_digest(), f"{command.value} is not bound to the task"
        assert manifest["inputs"]["task"]["criteria_file"]["digest"].startswith("sha256:")
    ledgers = [path.parent for d in artifacts.values() for path in Path(d).rglob("relaxations.yaml")]
    assert ledgers, "every zero-shot run must publish relaxations.yaml"
    for directory in ledgers:
        RelaxationLedger.read(directory)  # raises unless query_language, decoded_quantity, and exact are set
{% endif %}
