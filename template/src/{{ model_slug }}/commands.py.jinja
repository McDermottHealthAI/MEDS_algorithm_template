"""Model-owned implementations. Replace each run body and complete each profile's tests."""

from pathlib import Path

from meds_model_contract import Command, CommandName, STEP_SPECS, TaskSpec, digest_config, measured_artifact

PROFILES = {{ profiles | tojson }}
# Mark profiles complete independently; one implementation must not hide another profile's stub.
STUB_PROFILES = set(PROFILES)


class StubCommand(Command):
    def run(self, arguments):
        spec = STEP_SPECS[self.name]
        task = TaskSpec.from_arguments(arguments) if spec.task_conditioned else None
        with measured_artifact(
            Path(arguments[spec.output_argument]),
            artifact_type=spec.artifact_type.value,
            command=self.name.value,
            producer=f"{{ model_slug }}.commands.{type(self).__name__}",
            payload_format="stub/v1",
            config_digest=digest_config(dict(arguments)),
            external_predicates_file=arguments.get("external_predicates_file"),
            inputs=None if task is None else {"task": task.provenance()},
            semantics_digest=None if task is None else task.semantics_digest(),
            overwrite=arguments.get("do_overwrite", False),
        ):
            raise NotImplementedError(f"Implement {type(self).__name__}.run in src/{{ model_slug }}/commands.py")

