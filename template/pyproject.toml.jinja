[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ model_slug | replace('_', '-') }}"
version = "0.1.0"
description = "{{ model_description }}"
requires-python = ">=3.11"
dependencies = ["pyyaml>=6", "meds-model-core @ git+https://github.com/florian6973/meds-model-core.git@bfa347d13270bd29899671974d819e3c6c6f7ba8"]

[project.optional-dependencies]
# meds-evaluation is pinned to the version MEDS-DEV evaluates predictions with.
test = ["pytest>=8", "polars>=1", "pyarrow>=15", "meds-evaluation==0.0.3"]

[project.scripts]
meds-model = "{{ model_slug }}.__main__:main"
meds-model-resolve-input = "meds_model_contract.artifact_inputs:main"
meds-model-add-to-meds-dev = "meds_model_contract.meds_dev:main"

[tool.hatch.metadata]
allow-direct-references = true

[tool.hatch.build.targets.wheel]
packages = ["src/{{ model_slug }}", "src/meds_model_contract"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
  "meds_dev: opt-in end-to-end execution through MEDS-DEV",
  "real_data: opt-in MIMIC-IV demo end-to-end conformance",
  "slow: integration tests that create isolated environments or run a full model profile",
]
