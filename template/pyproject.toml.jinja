[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ algorithm_slug | replace('_', '-') }}"
version = "0.1.0"
description = "{{ algorithm_description }}"
requires-python = ">=3.11"
dependencies = ["pyyaml>=6", "meds-algorithm[data] @ git+https://github.com/McDermottHealthAI/meds-algorithm.git@99b3b59798d796360d1eff74fa75db58d35c4e90"]

[project.optional-dependencies]
# meds-evaluation is pinned to the version MEDS-DEV evaluates predictions with.
test = ["meds-algorithm[conformance] @ git+https://github.com/McDermottHealthAI/meds-algorithm.git@99b3b59798d796360d1eff74fa75db58d35c4e90"]

[project.scripts]
meds-algorithm = "{{ algorithm_slug }}.__main__:main"
{{ algorithm_slug | replace('_', '-') }} = "{{ algorithm_slug }}.__main__:main"

[tool.hatch.metadata]
allow-direct-references = true

[tool.hatch.build.targets.wheel]
packages = ["src/{{ algorithm_slug }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
  "meds_dev: opt-in end-to-end execution through MEDS-DEV",
  "real_data: opt-in MIMIC-IV demo end-to-end conformance",
  "slow: integration tests that create isolated environments or run a full algorithm profile",
]
