[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = {{ package_name | tojson }}
version = "0.1.0"
description = {{ algorithm_description | tojson }}
readme = "README.md"
authors = [{name = {{ author_name | tojson }}, email = {{ author_email | tojson }}}]
{% if license_expression %}license = {{ license_expression | tojson }}
license-files = ["LICENSE*"]
{% endif %}
requires-python = ">=3.11"
dependencies = ["pyyaml>=6", "meds-algorithm[data]==0.4.0a5"]

[project.optional-dependencies]
orchestration = ["meds-algorithm[orchestration]==0.4.0a5"]
# meds-evaluation is pinned to the version MEDS-DEV evaluates predictions with.
test = ["meds-algorithm[conformance]==0.4.0a5"]

{% if repository_url %}[project.urls]
Repository = {{ repository_url | tojson }}

{% endif %}[project.scripts]
{{ algorithm_slug | replace('_', '-') }} = "{{ algorithm_slug }}.__main__:main"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ algorithm_slug }}"]

# Keep one editable source; copy only portable defaults into the installed wheel.
[tool.hatch.build.targets.wheel.force-include]
"configs/runs" = "{{ algorithm_slug }}/resources/runs"
"algorithms" = "{{ algorithm_slug }}/resources/algorithms"

[tool.hatch.build.targets.sdist]
include = ["/src", "/configs/runs", "/algorithms", "/tests", "/scripts", "/docs", "/README.md", "/RELEASING.md", "/CHANGELOG.md", "/LICENSE*", "/pyproject.toml", "/uv.lock"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
  "meds_dev: opt-in end-to-end execution through MEDS-DEV",
  "real_data: opt-in MIMIC-IV demo end-to-end conformance",
  "slow: integration tests that create isolated environments or run a full algorithm profile",
]
