[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ model_slug | replace('_', '-') }}"
version = "0.1.0"
description = "{{ model_description }}"
requires-python = ">=3.11"
dependencies = ["pyyaml>=6", "meds-model-core @ git+https://github.com/florian6973/meds-model-core.git@a16ba1d5e6837bb0d50120cdf2e09b348745c964"]

[project.optional-dependencies]
# meds-evaluation is pinned to the version MEDS-DEV evaluates predictions with.
test = ["meds-model-core[conformance]"]

[project.scripts]
meds-model = "{{ model_slug }}.__main__:main"

[tool.hatch.metadata]
allow-direct-references = true

[tool.hatch.build.targets.wheel]
packages = ["src/{{ model_slug }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
markers = [
  "meds_dev: opt-in end-to-end execution through MEDS-DEV",
  "real_data: opt-in MIMIC-IV demo end-to-end conformance",
  "slow: integration tests that create isolated environments or run a full model profile",
]
