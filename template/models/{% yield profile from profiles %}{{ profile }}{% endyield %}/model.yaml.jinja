{% set train_step = {'supervised':'train_supervised', 'finetune':'train_finetune', 'probe':'train_probe'}.get(profile) %}
{% set predict_step = 'predict_only' if profile == 'predict_only' else 'predict_' + profile %}
{% set infer_step = 'infer_embeddings' if profile == 'probe' else 'infer_trajectories' %}
{% set inference_kind = 'embeddings' if profile == 'probe' else 'trajectories' %}
{% set model_kind = {'supervised':'supervised_model', 'finetune':'finetuned_model', 'probe':'probe_model'}.get(profile) %}
## MEDS-DEV descriptor for {{ model_name }}. This retains the established command-slot interface.
## Each MEDS-DEV run directory {output_dir} holds this run's artifacts as sibling subdirectories (data/,
## pretrained/, model/, embeddings/ or trajectories/, predictions/): MEDS-DEV keeps its own cmd.sh and .done marker in
## {output_dir}, and artifacts are published by atomically replacing their own destination directory.
{% if profile in ['zero_shot_direct', 'zero_shot_materialized'] %}## Zero-shot commands receive the task itself through {task_criteria_path}, which needs the MEDS-DEV
## passthrough described in SPEC.md section 2.4 (the analogue of {predicates_path}).
{% endif %}metadata:
  description: "{{ model_description }}"
  contacts:
    - name: "{{ author_name }}"
      email: "{{ author_email }}"

commands:
{% if profile in ['finetune', 'probe', 'zero_shot_direct', 'zero_shot_materialized'] %}  unsupervised:
    train: |-
      meds-model preprocess_data --profile {{ profile }} external_meds_dir={dataset_dir}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} output_data_dir={output_dir}/data do_overwrite=true
      meds-model pretrain --profile {{ profile }} input_data_dir={output_dir}/data output_pretrained_model_dir={output_dir}/pretrained
{% endif %}  supervised:
{% if profile in ['supervised', 'finetune', 'probe'] %}    train: |-
{% if profile == 'supervised' %}      meds-model preprocess_data --profile {{ profile }} external_meds_dir={dataset_dir}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} output_data_dir={output_dir}/data do_overwrite=true
{% endif %}{% if profile == 'probe' %}      meds-model {{ infer_step }} --profile {{ profile }} input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_index_dir={labels_dir} splits=[train,tuning,held_out] output_{{ inference_kind }}_dir={output_dir}/{{ inference_kind }} do_overwrite=true
      meds-model {{ train_step }} --profile {{ profile }} external_labels_dir={labels_dir} input_{{ inference_kind }}_dir={output_dir}/{{ inference_kind }} output_{{ model_kind }}_dir={output_dir}/model
{% elif profile == 'finetune' %}      meds-model {{ train_step }} --profile {{ profile }} input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_labels_dir={labels_dir} output_{{ model_kind }}_dir={output_dir}/model
{% else %}      meds-model {{ train_step }} --profile {{ profile }} input_data_dir={output_dir}/data external_labels_dir={labels_dir} output_{{ model_kind }}_dir={output_dir}/model
{% endif %}
{% else %}    train: null
{% endif %}    predict: |-
{% if profile == 'predict_only' %}      meds-model preprocess_data --profile {{ profile }} external_meds_dir={dataset_dir}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} output_data_dir={output_dir}/data do_overwrite=true
{% elif profile == 'zero_shot_materialized' %}      meds-model {{ infer_step }} --profile {{ profile }} input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_index_dir={labels_dir} splits=[{split}] output_{{ inference_kind }}_dir={output_dir}/{{ inference_kind }} do_overwrite=true
{% endif %}{% if profile in ['supervised', 'finetune', 'probe'] %}      meds-model {{ predict_step }} --profile {{ profile }} {% if profile == 'probe' %}input_embeddings_dir="$(meds-model-resolve-input {model_initialization_dir}/model input_embeddings_dir)"{% else %}input_data_dir="$(meds-model-resolve-input {model_initialization_dir}/model input_data_dir)"{% endif %} input_{{ model_kind }}_dir={model_initialization_dir}/model external_index_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir}/predictions do_overwrite=true external_evaluation_labels_dir={labels_dir}
{% elif profile == 'zero_shot_materialized' %}      meds-model {{ predict_step }} --profile {{ profile }} input_data_dir={model_initialization_dir}/data external_meds_dir={dataset_dir} input_{{ inference_kind }}_dir={output_dir}/{{ inference_kind }} external_index_dir={labels_dir} external_task_criteria_file={task_criteria_path}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} splits=[{split}] output_predictions_dir={output_dir}/predictions do_overwrite=true external_evaluation_labels_dir={labels_dir}
{% elif profile == 'zero_shot_direct' %}      meds-model {{ predict_step }} --profile {{ profile }} input_data_dir={model_initialization_dir}/data input_pretrained_model_dir={model_initialization_dir}/pretrained external_index_dir={labels_dir} external_task_criteria_file={task_criteria_path}{% if uses_predicates %} external_predicates_file={predicates_path}{% endif %} splits=[{split}] output_predictions_dir={output_dir}/predictions do_overwrite=true external_evaluation_labels_dir={labels_dir}
{% else %}      meds-model {{ predict_step }} --profile {{ profile }} input_data_dir={output_dir}/data external_index_dir={labels_dir} splits=[{split}] output_predictions_dir={output_dir}/predictions do_overwrite=true external_evaluation_labels_dir={labels_dir}
{% endif %}
